# Template for tests/integration/.env.qa (copy and fill in; .env.qa is gitignored).
#
# Required — SDK auth (same names as unique-cli)
UNIQUE_API_KEY=
UNIQUE_APP_ID=
UNIQUE_USER_ID=
UNIQUE_COMPANY_ID=

# Required — QA public chat gateway
UNIQUE_API_BASE=https://gateway.qa.unique.app/public/chat-gen2

# Optional — reuse an existing assistant instead of creating a temporary space
UNIQUE_ASSISTANT_ID=

# Optional — knowledge-base scope used in skillChoices.scopeId
UNIQUE_SCOPE_ID=
