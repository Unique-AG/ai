UNIQUE_API_BASE_URL=    # The backend URL of Unique's public API
UNIQUE_API_VERSION=     # The version of Unique's public API

UNIQUE_APP_ID=          # The app ID from the App section of Unique
UNIQUE_APP_KEY=         # The app key from the App section of Unique

# Webhook only (app.py): where this app is reachable, and the secret the
# platform signs its requests with.
UNIQUE_APP_ENDPOINT=
UNIQUE_APP_ENDPOINT_SECRET=

# Event socket only (sse.py): the credentials the stream runs on behalf of.
UNIQUE_AUTH_COMPANY_ID=
UNIQUE_AUTH_USER_ID=

# Which chat events reach the handler. Set at least one of these for sse.py —
# the event socket drops everything when both are empty. JSON lists.
UNIQUE_CHAT_EVENT_FILTER_OPTIONS_ASSISTANT_IDS=["assistant_<your-space-id>"]
UNIQUE_CHAT_EVENT_FILTER_OPTIONS_REFERENCES_IN_CODE=["<module-reference-in-code>"]
