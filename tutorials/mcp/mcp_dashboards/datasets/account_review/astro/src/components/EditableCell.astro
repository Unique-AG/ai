---
// One `<td class="editcell">` with a `<details class="cellmenu">` dropdown
// of `callTool` buttons — the portfolio table's inline risk editor.
import { callToolAttrs, clientRow } from "../lib/contract";
import type { EditableOption } from "../lib/editableCell";
import Icon from "./Icon.astro";

export interface Props {
  field: string;
  updateField: "risk_level";
  tdDataAttr: string;
  iconClass?: string;
  statClass: string;
  menuLabel: string;
  options: EditableOption[];
  refresh: string;
}

const { field, updateField, tdDataAttr, iconClass, statClass, menuLabel, options, refresh } = Astro.props;
const tdAttrs = clientRow.attr(tdDataAttr, field);
const iconAttrs = { tabindex: "0", ...clientRow.attr("data-tooltip", "compliance.risk_level_tooltip") };

function sourceArgs(value: string): string {
  return `{"pk":{id},"fields":{"${updateField}":"${value}"}}`;
}
---

<td class="editcell" {...tdAttrs}>
  <details class="cellmenu">
    <summary class="cellsum">
      <span class={statClass}>
        {
          iconClass && (
            <span class={iconClass} {...iconAttrs}>
              <Icon name="chevron-up" class="risk-icon risk-icon-high" size={16} />
              <Icon name="minus" class="risk-icon risk-icon-medium" size={16} />
              <Icon name="chevron-down" class="risk-icon risk-icon-low" size={16} />
            </span>
          )
        }
        <span class="cellval" {...clientRow.field(field)} />
      </span>
      <span class="caret"><Icon name="chevron-down" size={14} /></span>
    </summary>
    <div class="menu">
      <div class="menu-h">{menuLabel}</div>
      {
        options.map((opt) => (
          <button
            type="button"
            class={`menuitem ${opt.cssClass}`}
            {...callToolAttrs({ tool: opt.tool ?? "update_client", argsTemplate: sourceArgs(opt.value), refresh })}
          >
            {opt.label}
          </button>
        ))
      }
    </div>
  </details>
</td>
