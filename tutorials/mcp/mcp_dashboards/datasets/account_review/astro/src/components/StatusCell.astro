---
// Read-only status cell for the portfolio table: icon badge + grey label.
import { clientRow } from "../lib/contract";
import Icon from "./Icon.astro";
---

<td
  class="statcell"
  {...clientRow.attr("data-status", "case_action.status")}
>
  <span class="stat">
    <span class="status-indicator" tabindex="0" {...clientRow.attr("data-tooltip", "case_action.status")}>
      <Icon name="alert-circle" class="status-icon status-icon-alert" size={16} />
      <Icon name="flag" class="status-icon status-icon-flag" size={16} />
      <Icon name="bell" class="status-icon status-icon-bell" size={16} />
      <Icon name="arrow-up-right" class="status-icon status-icon-escalated" size={16} />
      <Icon name="shield-check" class="status-icon status-icon-compliant" size={16} />
    </span>
    <span class="cellval" {...clientRow.field("case_action.status")} />
  </span>
</td>
