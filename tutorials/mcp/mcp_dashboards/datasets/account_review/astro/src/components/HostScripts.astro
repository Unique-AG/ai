---
// Injects the one local host script a non-`live` build needs. Both files are
// bundled from src/host/ + helpers/astro/host/ into public/ by
// scripts/build-hosts.mjs; `live` gets
// neither, because the platform supplies its own data-unique-* engine.
//
// The `define:vars` blocks must stay `is:inline` — that directive only works on
// inline scripts — so each host reads its input off `window` rather than taking
// it as an argument.
import type { DashboardMode, McpLiveConfig, MockData } from "../lib/mode";

export interface Props {
  mode: DashboardMode;
  mockData: MockData | Record<string, never>;
  mcpLiveConfig: McpLiveConfig | null;
}

const { mode, mockData, mcpLiveConfig } = Astro.props;
---

{(mode === "preview" || mode === "live-local") && <pre id="mock-prompt-preview" hidden></pre>}
{mode === "preview" && (
  <script is:inline define:vars={{ mockData }}>
    window.__MOCK_DATA__ = mockData;
  </script>
)}
{mode === "preview" && <script is:inline src="/mock-host.js"></script>}
{mode === "live-local" && (
  <script is:inline define:vars={{ mcpLiveConfig }}>
    window.__MCP_LIVE_CONFIG__ = mcpLiveConfig;
  </script>
)}
{mode === "live-local" && <script is:inline src="/mcp-live-host.js"></script>}
