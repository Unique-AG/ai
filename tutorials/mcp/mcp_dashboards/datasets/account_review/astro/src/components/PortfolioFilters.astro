---
// Search + dropdown filters for the portfolio table. Values are merged into
// `list_clients` args by the local hosts via `data-unique-filter-bar`.
import Icon from "./Icon.astro";
---

<div class="portfolio-toolbar" data-unique-filter-bar="clientsLive">
  <label class="portfolio-search">
    <Icon name="search" class="portfolio-search-icon" size={16} />
    <input
      type="search"
      class="portfolio-search-input"
      placeholder="Filter by client name or ID"
      data-unique-filter-search
      autocomplete="off"
    />
  </label>
  <select class="portfolio-filter" data-unique-filter-field="status" aria-label="Filter by status">
    <option value="">Status</option>
    <option value="Needs Remediation">Needs Remediation</option>
    <option value="Escalated">Escalated</option>
    <option value="Compliant">Compliant</option>
  </select>
  <select class="portfolio-filter" data-unique-filter-field="risk_level" aria-label="Filter by risk">
    <option value="">Risk</option>
    <option value="High">High</option>
    <option value="Medium">Medium</option>
    <option value="Low">Low</option>
  </select>
  <select class="portfolio-filter" data-unique-filter-due aria-label="Filter by due date">
    <option value="">Due Date</option>
    <option value="urgent">Urgent</option>
    <option value="scheduled">Scheduled</option>
    <option value="none">No due date</option>
  </select>
</div>
