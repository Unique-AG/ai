# Ephemeral secretspec from nixpkgs flakes (no profile install, no <nixpkgs> channels).
# After editing: direnv allow
# First enter may take a few seconds; later enters reuse the store path.
watch_file shell.nix
watch_file secretspec.toml

SECRETSPEC_OUT="$(nix build --no-link --print-out-paths nixpkgs#secretspec)"
PATH_add "${SECRETSPEC_OUT}/bin"
