        "type": "object",
        "required": [
          "bucket",
          "label",
          "count"
        ],
        "properties": {
          "bucket": {
            "type": "string",
            "description": "Raw bucket value."
          },
          "label": {
            "type": "string",
            "description": "Display label for the bucket."
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of matching clients."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Single bucket returned by a count-by aggregation."
      },
      "CurrencyCode": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "Three-letter ISO 4217 currency code used for portfolio values."
      },
      "DashboardFigures": {
        "type": "object",
        "required": [
          "documents",
          "performance",
          "mandate",
          "holdings"
        ],
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FigureMetric"
            },
            "description": "Document and evidence metrics."
          },
          "performance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FigureMetric"
            },
            "description": "Performance-related metrics."
          },
          "mandate": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FigureMetric"
            },
            "description": "Mandate and suitability metrics."
          },
          "holdings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FigureMetric"
            },
            "description": "Holdings and portfolio composition metrics."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Grouped dashboard figures shown on the client detail cards."
      },
      "EmailAddress": {
        "type": "string",
        "format": "email",
        "description": "Email address for a client or contact person."
      },
      "FigureMetric": {
        "type": "object",
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metric label."
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metric display value."
          },
          "pct": {
            "anyOf": [
              {
                "type": "number",
                "format": "double"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metric percentage value, when available."
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Metric status text or severity marker."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Small dashboard metric used in client figures."
      },
      "IsoDate": {
        "type": "string",
        "format": "date",
        "description": "Calendar date serialized as ISO 8601 full-date text."
      },
      "OutboundEmailDraft": {
        "type": "object",
        "required": [
          "audience",
          "to",
          "subject",
          "body"
        ],
        "properties": {
          "audience": {
            "type": "string",
            "enum": [
              "client",
              "compliance"
            ],
            "description": "Whether this email goes to the client or to Compliance."
          },
          "to": {
            "$ref": "#/components/schemas/EmailAddress",
            "description": "Recipient email address."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line."
          },
          "body": {
            "type": "string",
            "description": "Email body text."
          },
          "new_status": {
            "type": "string",
            "enum": [
              "Compliant",
              "Escalated",
              "Screening hit",
              "Deadline approaching",
              "Limit exceeded",
              "Review required",
              "Regulatory breach",
              "Regulatory change"
            ],
            "description": "Optional new workflow status to apply after the email is accepted."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Email draft the RM reviews before sending outside the platform."
      },
      "PortfolioSummary": {
        "type": "object",
        "required": [
          "onboarded",
          "currency",
          "value"
        ],
        "properties": {
          "onboarded": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Date the client relationship was onboarded."
          },
          "currency": {
            "$ref": "#/components/schemas/CurrencyCode",
            "description": "Currency for the portfolio value."
          },
          "value": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "description": "Portfolio market value in the declared currency."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Portfolio-level values displayed in the dashboard."
      },
      "ReviewSchedule": {
        "type": "object",
        "required": [
          "last_reviewed",
          "next_review_due",
          "kyc_refresh_due"
        ],
        "properties": {
          "last_reviewed": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Date of the most recent completed review."
          },
          "next_review_due": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Next scheduled relationship review date."
          },
          "kyc_refresh_due": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Next KYC refresh due date."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Review dates used for KYC and suitability scheduling."
      },
      "SendEmailResult": {
        "type": "object",
        "required": [
          "client",
          "draft",
          "sent",
          "status_updated",
          "delivery_message"
        ],
        "properties": {
          "client": {
            "$ref": "#/components/schemas/Client",
            "description": "Client row after any accepted status update."
          },
          "draft": {
            "$ref": "#/components/schemas/OutboundEmailDraft",
            "description": "Email contents reviewed by the RM (present whether or not delivery was confirmed)."
          },
          "sent": {
            "type": "boolean",
            "description": "True when the RM confirmed send; false when draft review or send confirmation was cancelled."
          },
          "status_updated": {
            "type": "boolean",
            "description": "True when case_action.status was updated as part of a confirmed send."
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Simulated outbound message id when sent; null when not sent (demo facade, no real SMTP)."
          },
          "delivery_message": {
            "type": "string",
            "description": "Human-readable delivery outcome the agent must relay: whether the mail was sent or not."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Result of attempting to send an email after the RM reviews the draft."
      },
      "SortSpec": {
        "type": "object",
        "required": [
          "field"
        ],
        "properties": {
          "field": {
            "type": "string",
            "description": "Domain field path, for example identity.name or compliance.risk_level."
          },
          "dir": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Sort direction. Defaults to ascending when omitted."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Sort instruction accepted by list-style tools."
      },
      "SuitabilityProfile": {
        "type": "object",
        "required": [
          "investment_horizon",
          "knowledge_experience",
          "last_suitability_test",
          "suitability_outcome"
        ],
        "properties": {
          "investment_horizon": {
            "type": "string",
            "description": "Investment horizon label from the source workbook."
          },
          "knowledge_experience": {
            "type": "string",
            "description": "Knowledge and experience assessment."
          },
          "last_suitability_test": {
            "$ref": "#/components/schemas/IsoDate",
            "description": "Date of the most recent suitability test."
          },
          "suitability_outcome": {
            "type": "string",
            "description": "Outcome summary for the latest suitability review."
          }
        },
        "unevaluatedProperties": {
          "not": {}
        },
        "description": "Suitability assessment details for the client portfolio."
      }
    }
  }
}
