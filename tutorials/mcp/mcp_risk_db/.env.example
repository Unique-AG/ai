# HTTP server (FastMCP streamable HTTP). Default 8002.
# PORT=8002

# Public base URL of this MCP (OAuth redirect). Required in production.
# Local: http://127.0.0.1:8002
# Azure: https://risk-db-mcp-app.azurewebsites.net
# BASE_URL_ENV=http://127.0.0.1:8002

# Zitadel (same instance as MCP SQL demo)
# ZITADEL_URL=https://id.unique.app
# UPSTREAM_CLIENT_ID=
# UPSTREAM_CLIENT_SECRET=

# --- PostgreSQL (optional for local dev; required on Azure with deploy.sh) ---
# If unset, OAuth client registry uses in-memory storage; Excel mirror sync is skipped.

# Option A: single URL (used for OAuth client storage + Excel mirror). Azure deploy sets this.
# PG_CLIENT_STORAGE_URL=postgresql://user:password@host:5432/riskdb?sslmode=require

# Option B: discrete vars (local or custom)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=riskdb
# PGUSER=postgres
# PGPASSWORD=
# PG_SSLMODE=require

# Optional: override SQLAlchemy URL for Excel mirror only (defaults from PG_CLIENT_STORAGE_URL or PG* vars)
# PG_SYNC_URL=postgresql+psycopg2://user:pass@host:5432/riskdb?sslmode=require
