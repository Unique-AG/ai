# HTTP server (FastMCP streamable HTTP). Default 8002.
# PORT=8002

# Public base URL of this MCP (OAuth redirect). Required in production.
# Local: http://127.0.0.1:8002
# Azure: https://risk-db-mcp-app.azurewebsites.net
# BASE_URL_ENV=http://127.0.0.1:8002

# Zitadel (same instance as MCP SQL demo)
# ZITADEL_URL=https://id.unique.app
# UPSTREAM_CLIENT_ID=
# UPSTREAM_CLIENT_SECRET=

# Local OAuth client registrations persist here when Postgres is not configured.
# LOCAL_OAUTH_STORAGE_PATH=.local/oauth-client-store

# --- PostgreSQL (optional for local dev; required on Azure with deploy.sh) ---
# If unset, OAuth client registry uses the local file store; Excel mirror sync is skipped.

# Azure deploy sets these variables.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=riskdb
# PGUSER=postgres
# PGPASSWORD=
# PG_SSLMODE=require
